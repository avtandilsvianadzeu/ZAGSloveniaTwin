{"id":"stoze","name":"Stože Landslide","name_sl":"Plaz Stože pod Mangartom","type":"landslide","category":"zag_project","place":"Log pod Mangartom, Bovec","municipality":"Bovec","latitude":46.431593,"longitude":13.604744,"position_basis":"matched","position_exact":true,"zag_work_from":2002,"zag_work_to":2002,"built":null,"values":29,"values_with_source":29,"has_alignment":true,"has_building_outline":false,"model":"schematic","url":"https://avtandilsvianadzeu.github.io/ZAGSloveniaTwin/twin.html?id=stoze","detail":"https://avtandilsvianadzeu.github.io/ZAGSloveniaTwin/api/v1/objects/stoze.json","zag_role":"Investigations of the shear properties of the Stože pod Mangrtom landslide mass","zag_involvement_types":["research"],"description":"Investigations of the shear properties of the Stože pod Mangrtom landslide mass.","history":"About one million cubic metres failed on 17 November 2000 with the crown at 1,525 m, becoming the debris flow that reached Log pod Mangartom.","facts":[["Client","Ministry of Defence"],["Years","2002"]],"people":[],"partners":[],"position_sources":["https://www.openstreetmap.org/way/605594796","https://sl.wikipedia.org/wiki/Zemeljski_plaz_Sto%C5%BEe_pod_Mangartom"],"record_sources":[{"title":"Landslides, reference list","url":"https://www.zag.si/en/areas-of-expertise/natural-disasters-and-other-kinds-of-emergencies/landslides/","type":"inst"},{"title":"The Stože landslide and the Log pod Mangartom debris flow","url":"https://nhess.copernicus.org/articles/13/2543/2013/nhess-13-2543-2013.pdf","type":"journal"}],"specifications":[{"label":"Crown elevation","value":"1525","unit":"m","source":"https://nhess.copernicus.org/articles/13/2543/2013/nhess-13-2543-2013.pdf","quote":null},{"label":"Length","value":"about 1,500","unit":"m","source":"https://nhess.copernicus.org/articles/13/2543/2013/nhess-13-2543-2013.pdf","quote":null},{"label":"Width","value":"about 300","unit":"m","source":"https://nhess.copernicus.org/articles/13/2543/2013/nhess-13-2543-2013.pdf","quote":null},{"label":"Thickness","value":"up to 10, locally up to 50","unit":"m","source":"https://nhess.copernicus.org/articles/13/2543/2013/nhess-13-2543-2013.pdf","quote":null},{"label":"Volume","value":"about 1 million displaced, >1.5 million still mobilisable","unit":"m³","source":"https://nhess.copernicus.org/articles/13/2543/2013/nhess-13-2543-2013.pdf","quote":null},{"label":"Area","value":"slide ~25.7, valley impact ~50.1, total ~75.8","unit":"ha","source":"https://iaps.zrc-sazu.si/sites/default/files/Ostir_Landslide_Log_pod_Mangartom.pdf","quote":null},{"label":"Geology","value":"glacial moraine, scree and colluvium on fractured dolomite over Triassic marly limestone and marl","unit":"","source":"https://nhess.copernicus.org/articles/13/2543/2013/nhess-13-2543-2013.pdf","quote":null},{"label":"Event date","value":"17 November 2000 (after 1,638.4 mm rain in 46 days)","unit":"","source":"https://nhess.copernicus.org/articles/13/2543/2013/nhess-13-2543-2013.pdf","quote":null},{"label":"Debris flow runout","value":"about 4, to Log pod Mangartom (~600 m a.s.l.)","unit":"km","source":"https://ojs-gr.zrc-sazu.si/ujma/article/view/9175","quote":null},{"label":"Casualties","value":"7","unit":"","source":"https://www.gov.si/novice/2020-11-17-izvedena-dela-na-plazu-stovze-so-bistveno-prispevala-k-povecani-stopnji-varnosti-prebivalcev/","quote":null},{"label":"Damage","value":"6 buildings destroyed, 23 damaged, 150 m of Bovec-Predel road, 2 bridges, est. EUR 31.7 million","unit":"","source":"https://www.gov.si/novice/2020-11-17-izvedena-dela-na-plazu-stovze-so-bistveno-prispevala-k-povecani-stopnji-varnosti-prebivalcev/","quote":null},{"label":"Monitoring","value":"geodetic surveys, borehole inclinometers, precipitation and stream flow measurement, alarm system","unit":"","source":"https://www.gov.si/novice/2020-11-17-izvedena-dela-na-plazu-stovze-so-bistveno-prispevala-k-povecani-stopnji-varnosti-prebivalcev/","quote":null},{"label":"Remediation cost","value":"EUR 26.4 million spent by 2020, ~EUR 5 million still needed","unit":"","source":"https://www.gov.si/novice/2020-11-17-izvedena-dela-na-plazu-stovze-so-bistveno-prispevala-k-povecani-stopnji-varnosti-prebivalcev/","quote":null},{"label":"Zag author","value":"Borut Petkovšek (ZAG), Ujma 14-15 (2001)","unit":"","source":"https://ojs-gr.zrc-sazu.si/ujma/article/view/9175","quote":null},{"label":"First slide, 15 November 2000","value":"length 1 km, width about 0.1 km, volume about 600,000 m³","unit":"","source":"https://www.interpraevent.at/reference/media/1741/download/2004_4_IX-77.pdf?v=1","quote":"The length of the landslide was 1 km, the width approximately 0,1 km"},{"label":"Second slide, 17 November 2000","value":"area 200,000 m², volume 1,000,000 m³","unit":"","source":"https://www.interpraevent.at/reference/media/1741/download/2004_4_IX-77.pdf?v=1","quote":"landslide area 200.000 m2, landslide volume 1.000.000 m3"},{"label":"Elevation range of the Stože area","value":"1340 to 1580","unit":"m a.s.l.","source":"https://www.interpraevent.at/reference/media/1741/download/2004_4_IX-77.pdf?v=1","quote":"Stože area (1.340-1.580 m.a.s.l."},{"label":"Failure zone on the slope (second paper)","value":"between 1200 and 1500","unit":"m a.s.l.","source":"https://www.interpraevent.at/reference/media/1781/download/2004_4_VIII-181.pdf?v=1","quote":"failed between 1200 m and 1500 m"},{"label":"Release height above the torrent bed","value":"130 to 150","unit":"m","source":"https://www.interpraevent.at/reference/media/1741/download/2004_4_IX-77.pdf?v=1","quote":"about 130 to 150 meters above the torrent bed of Mangartski potok"},{"label":"Torrent bed slope, Mangartski potok","value":"15","unit":"%","source":"https://www.interpraevent.at/reference/media/1741/download/2004_4_IX-77.pdf?v=1","quote":"The maximum inclination of the torrent bed is 15%."},{"label":"Speed of the second slide","value":"8 to 10","unit":"m/s","source":"https://www.interpraevent.at/reference/media/1741/do